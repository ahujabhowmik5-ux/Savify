# ══════════════════════════════════════════════════════════════
# Savify — server / serverless environment variables
# Set these in the Vercel project (Settings → Environment Variables)
# and in server/.env for local runs.
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Cashfree payment gateway ──────────────────────────────────
# CASHFREE_ENV picks the stack: sandbox (test keys) or production (live keys).
# A key only works against its own stack. Live keys on an account that has not
# finished KYC/activation fail every order with
#   "transactions are not enabled for your payment gateway account".
# Leave CASHFREE_ENV blank to auto-detect: app IDs starting with TEST are
# treated as sandbox, everything else as production.
CASHFREE_ENV=production
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Check what the deployment is actually using (no secrets returned):
#   GET https://savify.in/api/payment/cashfree/config

# ── Web push (proximity notifications) ────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@savify.in

# ── WaSenderAPI (WhatsApp hall-group broadcasts) ──────────────
# API key from the WaSenderAPI dashboard for the connected WhatsApp session.
# Group JIDs are stored in the whatsapp_pool_groups table, not here —
# see supabase_whatsapp_pool_groups.sql.
WASENDER_API_KEY=
WASENDER_API_URL=https://www.wasenderapi.com
# Public URL used in the WhatsApp message's join link.
PUBLIC_APP_URL=https://savify.in
# Seconds to wait before the same pool may be broadcast again (default 900).
WASENDER_COOLDOWN_SECONDS=900
